{
    "swagger": "2.0",
    "info": {
        "description": "goempty HTTP API. Ordinary JSON responses use code/message/data; code 0 means success. Request IDs are returned in the X-Request-ID header. Health endpoints return an empty body.",
        "title": "goempty API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/healthz": {
            "get": {
                "tags": [
                    "health"
                ],
                "summary": "Check liveness",
                "responses": {
                    "200": {
                        "description": "OK; empty response body",
                        "headers": {
                            "X-Request-ID": {
                                "type": "string",
                                "description": "Request ID"
                            }
                        }
                    }
                }
            }
        },
        "/hello": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "hello"
                ],
                "summary": "Get a greeting",
                "responses": {
                    "200": {
                        "description": "Greeting returned successfully; code is 0",
                        "schema": {
                            "$ref": "#/definitions/response.Response-entity_HelloResponse"
                        },
                        "headers": {
                            "X-Request-ID": {
                                "type": "string",
                                "description": "Request ID"
                            }
                        }
                    },
                    "400": {
                        "description": "Internal error; code is -1, data is null",
                        "schema": {
                            "$ref": "#/definitions/response.Response-any"
                        },
                        "headers": {
                            "X-Request-ID": {
                                "type": "string",
                                "description": "Request ID"
                            }
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "description": "Returns 200 with an empty body; does not check MySQL or Redis connectivity.",
                "tags": [
                    "health"
                ],
                "summary": "Check readiness",
                "responses": {
                    "200": {
                        "description": "OK; empty response body",
                        "headers": {
                            "X-Request-ID": {
                                "type": "string",
                                "description": "Request ID"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "entity.HelloResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "hello"
                }
            }
        },
        "response.Response-any": {
            "type": "object",
            "properties": {
                "code": {
                    "description": "业务状态码，0 表示成功，非 0 表示失败；未知内部错误为 -1",
                    "type": "integer"
                },
                "data": {
                    "description": "接口业务数据；失败时为 null"
                },
                "message": {
                    "description": "响应消息，成功时为 success，失败时为可公开的错误说明",
                    "type": "string"
                },
                "request_id": {
                    "description": "预留的可选请求 ID，当前不输出此字段；实际请求 ID 通过 X-Request-ID 响应头返回",
                    "type": "string"
                }
            }
        },
        "response.Response-entity_HelloResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "description": "业务状态码，0 表示成功，非 0 表示失败；未知内部错误为 -1",
                    "type": "integer"
                },
                "data": {
                    "description": "接口业务数据；失败时为 null",
                    "allOf": [
                        {
                            "$ref": "#/definitions/entity.HelloResponse"
                        }
                    ]
                },
                "message": {
                    "description": "响应消息，成功时为 success，失败时为可公开的错误说明",
                    "type": "string"
                },
                "request_id": {
                    "description": "预留的可选请求 ID，当前不输出此字段；实际请求 ID 通过 X-Request-ID 响应头返回",
                    "type": "string"
                }
            }
        }
    }
}